# Replay archive (regenerable via `kaggle competitions replay <EPISODE_ID>`, ~180MB+)
Replays/

# Harness DB (rebuilt from replays via `python3 harness.py ingest ...`)
kaggriculture.db
kaggriculture.db-journal
kaggriculture.db.stale
kaggriculture.db-journal.stale

# Kaggle API credentials -- should live in ~/.kaggle/, never in this repo,
# but ignore them here too as a safety net
kaggle.json
access_token
.kaggle/

# Sandbox debugging artifacts, safe to delete
*.DELETE_ME_stray_fuse_artifact
test_journal.db*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS
.DS_Store

# Vendored engine source (fetched by setup_local_env.sh, not hand-edited)
vendor/kaggle_environments_engine/visualizer/
.cache/
.local/

# evolution loop artefacts
evolve/gen/
evolve/logs/
evolve/*.db
evolve/*.db-journal
evolve/evolve_bundle.zip
.mini_engine_cache/

# replay JSON dumps (regenerable, 200MB+)
Chatgpt Agents/Replay/
*.DELETE_ME_stray_fuse_artifact

# GitHub token for evolve/gh_push.py (Contents API)
.github/token

# evolution outputs are published to the results branch by the Air, not committed on master
evolve/reports/
evolve/archive.json
evolve/queue/done/
evolve/base/

# ntfy config (topic is a secret)
evolve/notify.conf
evolve/traces/

# generated candidates / scratch logs
candidates/gen/
candidates/gen_h/
candidates/__pycache__/
*.log

# scratch
.pylibs/
.pytmp/
.fuse_hidden*
*.pushclean
candidates/gen_p/
candidates/gen_lib/
