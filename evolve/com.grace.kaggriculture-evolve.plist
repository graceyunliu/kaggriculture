<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grace.kaggriculture-evolve</string>

    <!-- absolute path to the Kaggriculture checkout on the Air -->
    <key>WorkingDirectory</key>
    <string>/Users/graceliu/Kaggriculture</string>

    <!-- continuous mode: the supervisor loops forever; launchd restarts it if it exits -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>evolve/supervisor.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/graceliu/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/graceliu</string>
        <key>SEGMENT_HOURS</key>
        <string>2</string>
        <key>PROPOSE_N</key>
        <string>6</string>
        <key>PROPOSE_INTERVAL</key>
        <string>1800</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/graceliu/Kaggriculture/evolve/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/graceliu/Kaggriculture/evolve/logs/launchd.err</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
